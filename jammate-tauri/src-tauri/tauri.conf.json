{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JamMate",
  "version": "0.1.0",
  "identifier": "com.jammate.app",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "JamMate",
